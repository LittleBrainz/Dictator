<Window
    x:Class="Dictator.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dictator Settings">
  <ScrollViewer>
    <StackPanel x:Name="DiagnosticsRoot" Padding="32" Spacing="16" MaxWidth="960" HorizontalAlignment="Stretch">
      <TextBlock Text="Dictator Settings" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock Text="Diagnostics" Style="{StaticResource SubtitleTextBlockStyle}" />
      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
               Title="Phase 0"
               Message="This build verifies the application, native bridge, and distribution. Dictation and tray controls arrive in later phases." />
      <TextBox x:Name="IdentityText" Header="Build and native bridge identity"
               IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               FontFamily="Consolas" />
      <TextBlock Text="The native bridge completed a UTF-16 round-trip and a polling call. No microphone or network session is running."
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
